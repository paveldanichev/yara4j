<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.paveldan.yara4j</groupId>
    <artifactId>yara4j-parent</artifactId>
    <version>4.5.8-SNAPSHOT</version>
  </parent>

  <artifactId>yara4j-cli</artifactId>
  <name>yara4j-cli</name>
  <description>Command line tools (yara and yarac) for yara4j.</description>

  <properties>
    <!-- The command line tools aren't a library to depend on: they're released only on GitHub,
         not on Maven Central, so they aren't signed or deployed. -->
    <gpg.skip>true</gpg.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.paveldan.yara4j</groupId>
      <artifactId>yara4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.paveldan.yara4j</groupId>
      <artifactId>yara4j-magic-tika</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <!-- tika-core logs through SLF4J; silence it in the command line tools. -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The bundled dependencies have license and notice files with the same names, which
             would overwrite each other in the shaded jar: copy each one's files to
             META-INF/licenses/<artifactId>/ instead. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>third-party-licenses</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <excludeGroupIds>com.paveldan.yara4j</excludeGroupIds>
              <includes>META-INF/LICENSE*,META-INF/NOTICE*</includes>
              <outputDirectory>${project.build.directory}/third-party</outputDirectory>
              <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
              <stripVersion>true</stripVersion>
              <stripType>true</stripType>
              <fileMappers>
                <fileMapper implementation="org.codehaus.plexus.components.io.filemappers.FlattenFileMapper"/>
              </fileMappers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>third-party-licenses</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/licenses</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/third-party</directory>
                </resource>
                <resource>
                  <!-- picocli's jar has no license file. -->
                  <directory>src/main/licenses</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.paveldan.yara4j.cli.YaraCli</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                    <!-- Kept in META-INF/licenses/<artifactId>/, see above. -->
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
